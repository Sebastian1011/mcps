    "serialize-javascript": "7.1.1",
    "tar": "7.5.22",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/chrome": "0.1.1",
    "@types/node": "24.10.1",
    "archiver": "7.0.1",
    "esbuild": "0.25.12",
    "jsdom": "27.2.0",
    "sharp": "0.35.4",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
