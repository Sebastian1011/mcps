{
  "name": "clearblock",
  "version": "1.0.0",
  "private": true,
  "description": "A privacy-first Manifest V3 ad blocker for Chrome.",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
