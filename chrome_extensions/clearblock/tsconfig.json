{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@eyeo/webext-ad-filtering-solution": ["node_modules/@eyeo/webext-ad-filtering-solution/src/types/index.d.ts"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "types": ["chrome", "node"],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "scripts", "tests", "vitest.config.ts", "playwright.config.ts"]
}
