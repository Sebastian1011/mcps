# Copy to .env and adjust as needed. All values shown are the built-in
# defaults (see src/akshare_mcp/config.py) -- uncomment/change only what you
# need to override.

# --- transport ---
# MCP_TRANSPORT=streamable-http   # or "stdio" (for local CLI use, not Docker)
# MCP_HOST=0.0.0.0
# MCP_PORT=8000

# --- cache ---
# CACHE_DIR=/data/cache
# CACHE_SIZE_LIMIT=2147483648      # 2 GiB
# CACHE_TTL_CLOSED=604800          # 7 days -- history ranges that end before today
# CACHE_TTL_OPEN=3600              # 1 hour -- history ranges still in progress
# CACHE_TTL_REALTIME=10            # realtime quote table cache
# SYMBOL_TABLE_TTL=86400           # us_stock ticker->East-Money-code lookup table

# --- upstream rate limiting / retry (see fetch.py) ---
# AK_MAX_RETRIES=3
# AK_SOURCE_CONCURRENCY=2
# AK_MIN_INTERVAL_EASTMONEY=0.35
# AK_MIN_INTERVAL_DEFAULT=0.15
# AK_REQUEST_TIMEOUT=20

# --- misc ---
# TZ=Asia/Shanghai
# LOG_LEVEL=INFO

# --- outbound proxy, if your network requires one for reaching akshare's
#     upstream data sources (East Money / Sina / xueqiu / SGE / jin10) ---
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=127.0.0.1,localhost
